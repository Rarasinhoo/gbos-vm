+// Opt-in, bounded diagnostic: compare the server scanout with the private
+// presentation texture before acknowledging the server's ownership handshake.
+static void vm_dump_scanout(id<MTLBuffer> source, id<MTLBuffer> shadow,
+                            NSUInteger width, NSUInteger height, NSUInteger stride,
+                            BOOL bgra, CGRect rect, unsigned sample) {
+    const char *directory = getenv("VM_NATIVE_DIAGNOSTIC_DIR");
+    if (!directory || !source || !shadow) return;
+    const unsigned char *a=source.contents, *b=shadow.contents;
+    NSUInteger different=0, outside=0;
+    for (NSUInteger y=0;y<height;y++) for (NSUInteger x=0;x<width;x++) {
+        NSUInteger off=y*stride+x*4;
+        if (memcmp(a+off,b+off,3)) {
+            different++;
+            if (!CGRectContainsPoint(rect,CGPointMake(x,y))) outside++;
+        }
+    }
+    fprintf(stderr,"SCANOUT_COMPARE sample=%u pixels=%lu different=%lu outside_damage=%lu rect=%.0f,%.0f,%.0f,%.0f\n",sample,width*height,different,outside,rect.origin.x,rect.origin.y,rect.size.width,rect.size.height);
+    for (unsigned which=0;which<2;which++) {
+        NSString *path=[NSString stringWithFormat:@"%s/%02u-%s.ppm",directory,sample,which?"shadow":"source"];
+        FILE *file=fopen(path.fileSystemRepresentation,"wb"); if(!file) continue;
+        fprintf(file,"P6\n%lu %lu\n255\n",width,height);
+        const unsigned char *pixels=which?b:a;
+        unsigned char *row=malloc(width*3);
+        for(NSUInteger y=0;y<height;y++) {
+            for(NSUInteger x=0;x<width;x++) {
+                const unsigned char *p=pixels+y*stride+x*4;
+                row[x*3]=p[bgra?2:0];row[x*3+1]=p[1];row[x*3+2]=p[bgra?0:2];
+            }
+            fwrite(row,3,width,file);
+        }
+        free(row);fclose(file);
+    }
+}
