+/// Whether frames are locked to the guest's frame clock (VM_NO_PACING=1 turns it off)
+- (BOOL)_clockLocked {
+    static int locked = -1;
+    if (locked < 0) locked = !(getenv("VM_NO_PACING") && !strcmp(getenv("VM_NO_PACING"), "1"));
+    return locked && self.guestRefresh > 0;
+}
+
+/// When to show a guest frame that arrived at `arrived`, or 0 for "now".
+///
+/// Guest frames are made on the guest's own clock, one per `1/guestRefresh`,
+/// but reach us after a GPU copy and two thread hops that add a few
+/// milliseconds of jitter. Shown as soon as they arrive, a frame that lands
+/// just before or after one of this display's refreshes stays up one refresh
+/// too long or too short: judder, even when the rates match exactly.
+///
+/// So rebuild the guest's clock from recent arrivals and show every frame at
+/// the same offset from its slot on that clock. The slots are anchored on the
+/// earliest arrivals (the 10th percentile: frames with the least delay show
+/// where the clock really is) and follow it as it drifts; the offset is the
+/// spread of recent delays (90th percentile) plus a millisecond to render. A
+/// frame later than that is shown at once rather than held further.
+- (CFTimeInterval)_presentTimeForArrival:(CFTimeInterval)arrived {
+    if (![self _clockLocked] || arrived <= 0) {
+        return 0;
+    }
+    const double period = 1.0 / self.guestRefresh;
+    const unsigned capacity = sizeof(_arrivals) / sizeof(_arrivals[0]);
+    // After a pause (nothing changed on screen) the old clock is too stale to trust.
+    if (_arrivalCount == 0 || arrived - _slot > 2) {
+        _arrivalCount = 0;
+        _slot = arrived;
+    }
+    _arrivals[_arrivalCount++ % capacity] = arrived;
+    unsigned n = MIN(_arrivalCount, capacity);
+    // Each arrival's delay past its slot, in [-period/2, period/2)
+    double delays[capacity];
+    for (unsigned i = 0; i < n; i++) {
+        delays[i] = remainder(_arrivals[i] - _slot, period);
+    }
+    qsort_b(delays, n, sizeof(double), ^int(const void *a, const void *b) {
+        double d = *(const double *)a - *(const double *)b; return (d > 0) - (d < 0);
+    });
+    double earliest = delays[n / 10], spread = delays[n * 9 / 10] - earliest;
+    // Re-anchor on the newest frame's slot, so the clock follows guest drift.
+    _slot = arrived - remainder(arrived - (_slot + earliest), period);
+    if (n < 8) {
+        return 0;
+    }
+    CFTimeInterval at = _slot + MIN(spread, period) + 0.001;
+    return at > CACurrentMediaTime() + 0.0005 ? at : 0;
+}
