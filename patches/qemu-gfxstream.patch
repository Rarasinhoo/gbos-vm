+
+/* A blit copies bytes as they are; a shader read and write converts between formats. */
+- (BOOL)convertFrom:(MTLOrigin)origin size:(MTLSize)size to:(CGPoint)dest
+      commandBuffer:(id<MTLCommandBuffer>)commandBuffer
+{
+    if (!self.convertPipeline) {
+        static NSString *const source =
+            @"#include <metal_stdlib>\n"
+             "using namespace metal;\n"
+             "kernel void convert(texture2d<half, access::read> src [[texture(0)]],\n"
+             "                    texture2d<half, access::write> dst [[texture(1)]],\n"
+             "                    constant uint4 &r [[buffer(0)]],\n"
+             "                    constant uint2 &dest [[buffer(1)]],\n"
+             "                    uint2 gid [[thread_position_in_grid]]) {\n"
+             "    if (gid.x >= r.z || gid.y >= r.w) return;\n"
+             "    dst.write(src.read(gid + r.xy), gid + dest);\n"
+             "}\n";
+        NSError *error = nil;
+        id<MTLDevice> device = self.renderTarget.device;
+        id<MTLLibrary> library = [device newLibraryWithSource:source options:nil error:&error];
+        id<MTLFunction> function = [library newFunctionWithName:@"convert"];
+        id<MTLComputePipelineState> pipeline =
+            function ? [device newComputePipelineStateWithFunction:function error:&error] : nil;
+        [function release];
+        [library release];
+        if (!pipeline) {
+            fprintf(stderr, "spice-display-metal: no conversion shader: %s\n",
+                    error.localizedDescription.UTF8String);
+            return NO;
+        }
+        self.convertPipeline = pipeline;
+        [pipeline release];
+    }
+    uint32_t r[4] = { origin.x, origin.y, size.width, size.height };
+    uint32_t d[2] = { dest.x, dest.y };
+    id<MTLComputeCommandEncoder> encoder = [commandBuffer computeCommandEncoder];
+    [encoder setComputePipelineState:self.convertPipeline];
+    [encoder setTexture:self.scanoutTexture atIndex:0];
+    [encoder setTexture:self.renderTarget atIndex:1];
+    [encoder setBytes:r length:sizeof(r) atIndex:0];
+    [encoder setBytes:d length:sizeof(d) atIndex:1];
+    [encoder dispatchThreads:MTLSizeMake(size.width, size.height, 1)
+       threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];
+    [encoder endEncoding];
+    return YES;
 }
 
 @end
