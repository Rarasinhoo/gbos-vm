+/*
+ * Zero-copy display: gfxstream (loaded with rutabaga) can hand over the Metal texture behind a
+ * resource, and the SPICE display blits that straight into the surface the viewer shows, as it
+ * does for virglrenderer. Without it every flush reads the whole frame back to the CPU.
+ */
+typedef int (*get_metal_texture_fn)(uint32_t res_handle, void **texture);
+static bool metal_scanout[VIRTIO_GPU_MAX_SCANOUTS];
+
+static get_metal_texture_fn rutabaga_metal_texture_fn(void)
+{
+    static get_metal_texture_fn fn;
+    static bool looked;
+    if (!looked) {
+        looked = true;
+        if (!getenv("GBOS_GFXSTREAM_READBACK")) {
+            fn = (get_metal_texture_fn)dlsym(RTLD_DEFAULT,
+                                             "stream_renderer_resource_get_metal_texture");
+        }
+    }
+    return fn;
+}
+#endif
