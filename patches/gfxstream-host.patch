+// YV12 and YV21 arrive in Android's layout: Y rows padded to 32 bytes, then two chroma planes
+// (V first for YV12, U first for YV21) with half that stride. They are kept in NV12-shaped images
+// (see ToVkFormat); this moves the bytes between the two layouts. `copies` describes the image's
+// staging layout: plane 0 (Y), then plane 1 (interleaved UV).
+static bool IsPlanar420(GfxstreamFormat format) {
+    return format == GfxstreamFormat::YV12 || format == GfxstreamFormat::YV21;
+}
+static size_t Planar420Size(uint32_t width, uint32_t height) {
+    const size_t yStride = (width + 31) & ~31u;
+    return yStride * height + 2 * (yStride / 2) * (height / 2);
+}
+static void ConvertPlanar420(GfxstreamFormat format, const VkExtent3D& extent,
+                             const std::vector<VkBufferImageCopy>& copies, uint8_t* planar,
+                             uint8_t* staging, bool toStaging) {
+    const uint32_t w = extent.width, h = extent.height;
+    const size_t yStride = (w + 31) & ~31u, cStride = yStride / 2, cHeight = h / 2;
+    uint8_t* first = planar + yStride * h;
+    uint8_t* second = first + cStride * cHeight;
+    uint8_t* u = format == GfxstreamFormat::YV12 ? second : first;
+    uint8_t* v = format == GfxstreamFormat::YV12 ? first : second;
+    const VkBufferImageCopy& yCopy = copies[0];
+    const VkBufferImageCopy& cCopy = copies[1];
+    const size_t yRow = yCopy.bufferRowLength ? yCopy.bufferRowLength : yCopy.imageExtent.width;
+    const size_t cRow = 2 * (cCopy.bufferRowLength ? cCopy.bufferRowLength : cCopy.imageExtent.width);
+    const uint32_t cWidth = std::min<uint32_t>(cCopy.imageExtent.width, cStride);
+    const uint32_t cRows = std::min<uint32_t>(cCopy.imageExtent.height, cHeight);
+    for (uint32_t row = 0; row < h; ++row) {
+        uint8_t* s = staging + yCopy.bufferOffset + row * yRow;
+        uint8_t* p = planar + row * yStride;
+        if (toStaging) std::memcpy(s, p, w); else std::memcpy(p, s, w);
+    }
+    for (uint32_t row = 0; row < cRows; ++row) {
+        uint8_t* s = staging + cCopy.bufferOffset + row * cRow;
+        for (uint32_t x = 0; x < cWidth; ++x) {
+            if (toStaging) {
+                s[2 * x] = u[row * cStride + x];
+                s[2 * x + 1] = v[row * cStride + x];
+            } else {
+                u[row * cStride + x] = s[2 * x];
+                v[row * cStride + x] = s[2 * x + 1];
+            }
+        }
+    }
+}
