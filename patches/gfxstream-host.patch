+MTLResource_id VkEmulation::getColorBufferMetalTexture(uint32_t colorBufferHandle) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    // The generated device dispatch leaves this extension's entry point out; ask the driver.
+    static PFN_vkExportMetalObjectsEXT exportMetalObjects =
+        mDvk->vkExportMetalObjectsEXT
+            ? mDvk->vkExportMetalObjectsEXT
+            : (PFN_vkExportMetalObjectsEXT)mIvk->vkGetDeviceProcAddr(mDevice,
+                                                                     "vkExportMetalObjectsEXT");
+    auto* info = gfxstream::base::find(mColorBuffers, colorBufferHandle);
+    if (!info || info->image == VK_NULL_HANDLE || !exportMetalObjects) {
+        GFXSTREAM_WARNING("No Metal texture for ColorBuffer %u (known %d, export %d)",
+                          colorBufferHandle, info != nullptr, exportMetalObjects != nullptr);
+        return nullptr;
+    }
+    VkExportMetalTextureInfoEXT texture = {
+        .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT,
+        .image = info->image,
+        .plane = VK_IMAGE_ASPECT_PLANE_0_BIT,
+    };
+    VkExportMetalObjectsInfoEXT objects = {
+        .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+        .pNext = &texture,
+    };
+    exportMetalObjects(mDevice, &objects);
+    if (!texture.mtlTexture) {
+        GFXSTREAM_WARNING("ColorBuffer %u: Vulkan driver exported no Metal texture",
+                          colorBufferHandle);
+    }
+    return texture.mtlTexture;
+}
